  "lines": [
    {
      "id": "intro-1",
      "text": "أَنْتَ الْآنَ قُبْطَانُ سَفِينَةٍ! طَاقَمُكَ مِنَ الْقَرَاصِنَةِ الطَّيِّبِينَ يَنْتَظِرُ أَوَامِرَكَ، وَالْجُزُرُ مَلِيئَةٌ بِالْكُنُوزِ.",
      "file": "intro-1.mp3",
      "seconds": 8.54,
      "stamp": "d2275a716abe"
    },
    {
      "id": "intro-2",
      "text": "الْقُبْطَانُ الْجَيِّدُ عَادِلٌ. عِنْدَمَا نَجِدُ كَنْزًا نَقْسِمُهُ بِالتَّسَاوِي، فَيَأْخُذُ كُلُّ قُرْصَانٍ الْعَدَدَ نَفْسَهُ. وَهَذِهِ هِيَ الْقِسْمَةُ!",
      "file": "intro-2.mp3",
      "seconds": 10.46,
      "stamp": "c7a5218e79d3"
    },
    {
      "id": "intro-3",
      "text": "وَأَنَا كُوكُو الْبَبَّغَاءُ! وَإِذَا بَقِيَ فِي الصُّنْدُوقِ شَيْءٌ لَا يَكْفِي لِلْجَمِيعِ، فَهُوَ لِي! هَا هَا هَا!",
      "file": "intro-3.mp3",
      "seconds": 8.35,
      "stamp": "95317eefbbff"
    },
    {
      "id": "intro-4",
      "text": "احْذَرِ الْقُبْطَانَ شَنَبُو وَالْأُخْطُبُوطَ الْعِمْلَاقَ! اهْزِمْهُمَا بِالْقِسْمَةِ الصَّحِيحَةِ، لِيُصْبِحَ حَيَوَانُ كُلِّ جَزِيرَةٍ صَدِيقًا فِي طَاقَمِكَ.",
      "file": "intro-4.mp3",
      "seconds": 9.6,
      "stamp": "2bd9883705a3"
    },
    {
      "id": "tut-0",
      "text": "وَجَدْنَا سِتَّ قِطَعٍ! نَقْسِمُهَا بِالْعَدْلِ عَلَى قُرْصَانَيْنِ. اضْغَطْ زِرَّ «وَزِّعْ بِنَفْسِي» لِتُعْطِيَ كُلَّ قُرْصَانٍ قِطْعَةً فِي كُلِّ مَرَّةٍ.",
      "file": "tut-0.mp3",
      "seconds": 10.66,
      "stamp": "dc0a0d4013e3"
    },
    {
      "id": "tut-1",
      "text": "ثَمَانِي قِطَعٍ لِقُرْصَانَيْنِ. كَمْ يَأْخُذُ كُلُّ وَاحِدٍ؟",
      "file": "tut-1.mp3",
      "seconds": 4.75,
      "stamp": "f4e69a14cb0f"
    },
    {
      "id": "tut-2",
      "text": "نَقْسِمُ اثْنَتَيْ عَشْرَةَ جَوْهَرَةً عَلَى ثَلَاثَةِ قَرَاصِنَةٍ. كَمْ يَأْخُذُ كُلُّ وَاحِدٍ؟",
      "file": "tut-2.mp3",
      "seconds": 6.29,
      "stamp": "7ccbbd587e6d"
    },
    {
      "id": "tut-3",
      "text": "قُرْصَانٌ وَاحِدٌ فَقَطْ، وَخَمْسُ لَآلِئَ. كَمْ يَأْخُذُ؟",
      "file": "tut-3.mp3",
      "seconds": 4.85,
      "stamp": "c0e7f9d6a2f9"
    },
    {
      "id": "tut-4",
