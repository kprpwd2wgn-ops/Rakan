  "lines": [
    {
      "id": "dc5c570126fd",
      "text": "أَحْسَنْتَ!",
      "file": "dc5c570126fd.mp3",
      "seconds": 0.72,
      "stamp": "5efbc42ec9ea"
    },
    {
      "id": "1a4a78eba67f",
      "text": "مُمْتَازٌ!",
      "file": "1a4a78eba67f.mp3",
      "seconds": 0.94,
      "stamp": "c617d95a3c0a"
    },
    {
      "id": "9a82683a66d7",
      "text": "إِجَابَةٌ صَحِيحَةٌ!",
      "file": "9a82683a66d7.mp3",
      "seconds": 1.32,
      "stamp": "1d42c3dbc838"
    },
    {
      "id": "8ade9d3beb7b",
      "text": "رَائِعٌ، أَنْتَ بَطَلٌ!",
      "file": "8ade9d3beb7b.mp3",
      "seconds": 1.63,
      "stamp": "3fe5bfc0459b"
    },
    {
      "id": "46d842d3499a",
      "text": "انْتَبِهْ، هَذِهِ هِيَ الْإِجَابَةُ الصَّحِيحَةُ.",
      "file": "46d842d3499a.mp3",
      "seconds": 2.98,
      "stamp": "0f5435caf3f2"
    },
    {
      "id": "6b1c994a613f",
      "text": "أَنْتَ بَطَلٌ! أَنْتَ جَاهِزٌ لِلِاخْتِبَارِ.",
      "file": "6b1c994a613f.mp3",
      "seconds": 3.43,
      "stamp": "d18e8f090dd1"
    },
    {
      "id": "173b90b65a84",
      "text": "مُمْتَازٌ! رَاجِعْ أَخْطَاءَكَ الْقَلِيلَةَ.",
      "file": "173b90b65a84.mp3",
      "seconds": 3.6,
      "stamp": "3e75c096e285"
    },
    {
      "id": "b70df8a6b6a3",
      "text": "جَيِّدٌ! تَحْتَاجُ إِلَى مَزِيدٍ مِنَ التَّدْرِيبِ.",
      "file": "b70df8a6b6a3.mp3",
      "seconds": 3.89,
      "stamp": "6938bbc91984"
    },
    {
      "id": "de43d56f9e96",
      "text": "لَا بَأْسَ، رَاجِعْ دُرُوسَكَ ثُمَّ حَاوِلْ مِنْ جَدِيدٍ.",
      "file": "de43d56f9e96.mp3",
      "seconds": 3.65,
      "stamp": "7d9e9aff104d"
    },
    {
      "id": "140488b404d6",
      "text": "أَيْنَ كَانَ الشَّقِيقَانِ يَلْعَبَانِ الْكُرَةَ؟",
      "file": "140488b404d6.mp3",
      "seconds": 2.45,
      "stamp": "d7cfcfaf3a1c"
    },
    {
      "id": "d2b1965f420f",
      "text": "كَانَ طَارِقٌ وَزِيَادٌ يَلْعَبَانِ الْكُرَةَ فِي فِنَاءِ مَنْزِلِهِمَا، فَرَكَلَ زِيَادٌ الْكُرَةَ بِقُوَّةٍ، فَسَقَطَتْ فِي حَدِيقَةِ الْجَارِ.",
      "file": "d2b1965f420f.mp3",
      "seconds": 8.21,
      "stamp": "4b8b50bbdd29"
    },
    {
      "id": "291905e6239d",
      "text": "كَيْفَ قَرَعَ طَارِقٌ الْبَابَ؟",
      "file": "291905e6239d.mp3",
      "seconds": 2.02,
      "stamp": "7744ee745d66"
    },
    {
      "id": "42feed034cbd",
      "text": "قَرَعَ طَارِقٌ الْبَابَ بِلُطْفٍ وَقَالَ: السَّلَامُ عَلَيْكُمْ يَا عَمُّ، هَلْ تَسْمَحُ لَنَا بِأَخْذِ الْكُرَةِ؟ فَأَعْطَاهُ الْجَارُ الْكُرَةَ مُبْتَسِمًا.",
      "file": "42feed034cbd.mp3",
      "seconds": 9.72,
      "stamp": "b5eaa201e6db"
    },
    {
      "id": "2939236b1faf",
      "text": "لِمَاذَا لَمْ يُعْطِ الْجَارُ زِيَادًا الْكُرَةَ؟",
      "file": "2939236b1faf.mp3",
      "seconds": 2.62,
      "stamp": "8353e305d412"
    },
    {
      "id": "60ea2a081404",
      "text": "رَكَلَ زِيَادٌ الْكُرَةَ مَرَّةً أُخْرَى، فَذَهَبَ إِلَى الْجَارِ وَصَاحَ: هَيَّا، أَعْطِنِي الْكُرَةَ بِسُرْعَةٍ! فَغَضِبَ الْجَارُ وَلَمْ يُعْطِهِ الْكُرَةَ.",
      "file": "60ea2a081404.mp3",
      "seconds": 9.96,
      "stamp": "dbba8b0d40be"
    },
    {
      "id": "838572eb141b",
      "text": "مَاذَا فَعَلَ الْجَارُ بَعْدَ اعْتِذَارِ زِيَادٍ؟",
      "file": "838572eb141b.mp3",
      "seconds": 2.69,
      "stamp": "9ebc3f4bf5ca"
    },
    {
      "id": "f8848d7b25d8",
      "text": "خَجِلَ زِيَادٌ مِنْ تَصَرُّفِهِ، وَقَالَ: أَعْتَذِرُ عَنْ خَطَئِي يَا عَمُّ، وَأَرْجُو أَنْ تُسَامِحَنِي. فَسَامَحَهُ الْجَارُ وَأَعْطَاهُ الْكُرَةَ.",
      "file": "f8848d7b25d8.mp3",
      "seconds": 9.91,
      "stamp": "abff1b89ed4b"
    },
    {
      "id": "c55ce2b8ea36",
      "text": "كَيْفَ عَرَضَتْ سَارَةُ الصُّوَرَ؟",
      "file": "c55ce2b8ea36.mp3",
      "seconds": 1.82,
      "stamp": "2605d9a1f0e4"
    },
    {
      "id": "bffb0387ba6b",
      "text": "كَلَّفَتِ الْمُعَلِّمَةُ نُورَةَ وَصَدِيقَتَهَا سَارَةَ بِمَشْرُوعٍ عَنْ مَعَالِمِ بِلَادِنَا، فَجَمَعَتْ نُورَةُ الْمَعْلُومَاتِ مِنَ الْكُتُبِ وَالْمَجَلَّاتِ، وَعَرَضَتْ سَارَةُ الصُّوَرَ عَلَى شَاشَةِ الْحَاسُوبِ.",
      "file": "bffb0387ba6b.mp3",
      "seconds": 11.64,
      "stamp": "7cefb38390aa"
    },
    {
      "id": "a91712794415",
      "text": "أَيْنَ تَقَعُ نَافُورَةُ الْمَلِكِ فَهْدٍ؟",
      "file": "a91712794415.mp3",
      "seconds": 2.28,
      "stamp": "68d3d05978c5"
    },
    {
      "id": "a1a820e91a35",
      "text": "تَقَعُ الْكَعْبَةُ الْمُشَرَّفَةُ فِي مَكَّةَ الْمُكَرَّمَةِ، وَيَقَعُ الْمَسْجِدُ النَّبَوِيُّ الشَّرِيفُ فِي الْمَدِينَةِ الْمُنَوَّرَةِ، وَتَقَعُ نَافُورَةُ الْمَلِكِ فَهْدٍ فِي جُدَّةَ.",
      "file": "a1a820e91a35.mp3",
      "seconds": 9.34,
      "stamp": "48f46200bb07"
    },
    {
      "id": "22980ddc8a0a",
      "text": "مَا عَاصِمَةُ الْمَمْلَكَةِ الْعَرَبِيَّةِ السُّعُودِيَّةِ؟",
      "file": "22980ddc8a0a.mp3",
      "seconds": 2.78,
      "stamp": "05be70783913"
    },
    {
      "id": "dddd8f548478",
      "text": "الرِّيَاضُ عَاصِمَةُ الْمَمْلَكَةِ الْعَرَبِيَّةِ السُّعُودِيَّةِ، وَمِنْ مَعَالِمِهَا قَصْرُ الْمَصْمَكِ.",
      "file": "dddd8f548478.mp3",
      "seconds": 5.57,
      "stamp": "e046f22e86dc"
    },
    {
      "id": "ecb55714d514",
      "text": "مَا الْخُلُقُ الَّذِي ظَهَرَ فِي تَصَرُّفِ سَعْدٍ؟",
      "file": "ecb55714d514.mp3",
      "seconds": 2.64,
      "stamp": "b993d13c2792"
    },
    {
      "id": "5f520a29a833",
      "text": "رَأَى سَعْدٌ رَجُلًا كَبِيرًا يَحْمِلُ أَكْيَاسًا ثَقِيلَةً، فَأَسْرَعَ إِلَيْهِ وَحَمَلَ عَنْهُ بَعْضَهَا، فَشَكَرَهُ الرَّجُلُ وَدَعَا لَهُ.",
      "file": "5f520a29a833.mp3",
      "seconds": 7.97,
      "stamp": "3ee485f7c6f8"
    },
    {
      "id": "e18db9d745bb",
      "text": "مَاذَا نُسَمِّي مَا فَعَلَهُ خَالِدٌ؟",
      "file": "e18db9d745bb.mp3",
      "seconds": 2.45,
      "stamp": "e8022b25b2f1"
    },
    {
      "id": "35b4fc6d2b23",
      "text": "كَانَ مَعَ خَالِدٍ تُفَّاحَةٌ وَاحِدَةٌ، وَكَانَ صَدِيقُهُ جَائِعًا، فَأَعْطَاهُ التُّفَّاحَةَ وَهُوَ يُحِبُّهَا.",
      "file": "35b4fc6d2b23.mp3",
      "seconds": 7.1,
      "stamp": "7bfb9c1e2ad6"
    },
    {
      "id": "a8da028c8e87",
      "text": "لِمَاذَا لَا نُطِيلُ النَّظَرَ إِلَى الْهَاتِفِ؟",
      "file": "a8da028c8e87.mp3",
      "seconds": 2.59,
      "stamp": "d0ea2975f3f6"
    },
    {
      "id": "15486d269ceb",
      "text": "الْهَاتِفُ الْمَحْمُولُ نِعْمَةٌ، نَتَّصِلُ بِهِ بِأَهْلِنَا وَنَبْحَثُ عَنِ الْمَعْلُومَاتِ، وَلَكِنْ لَا نُطِيلُ النَّظَرَ إِلَيْهِ حَتَّى لَا تَتْعَبَ أَعْيُنُنَا.",
      "file": "15486d269ceb.mp3",
      "seconds": 8.83,
      "stamp": "501092f72765"
    },
    {
      "id": "50e6fbfd6ff5",
      "text": "أَيْنَ تَدُورُ الْأَقْمَارُ الصِّنَاعِيَّةُ؟",
      "file": "50e6fbfd6ff5.mp3",
      "seconds": 2.09,
      "stamp": "9524a08b2a2e"
    },
    {
      "id": "2a003dbfe700",
      "text": "الْأَقْمَارُ الصِّنَاعِيَّةُ تَدُورُ حَوْلَ الْأَرْضِ، وَتُسَاعِدُنَا فِي مَعْرِفَةِ حَالَةِ الطَّقْسِ.",
      "file": "2a003dbfe700.mp3",
      "seconds": 5.64,
      "stamp": "a80cabdfb1b3"
    },
    {
      "id": "93ef82ef9947",
      "text": "لِمَاذَا فَرِحَتْ أُسْرَةُ عَادِلٍ؟",
      "file": "93ef82ef9947.mp3",
      "seconds": 2.11,
      "stamp": "397265ac6cc6"
    },
    {
      "id": "810d6258ef74",
      "text": "مَاذَا فَعَلَ عَادِلٌ مَعَ الْمَرْأَةِ الَّتِي لَمْ تَجِدْ مَقْعَدًا؟",
      "file": "810d6258ef74.mp3",
      "seconds": 3.58,
      "stamp": "a04290bfb602"
    },
    {
      "id": "b4fa2bcc1435",
      "text": "مَنْ أَرْشَدَ عَادِلًا إِلَى مَقْعَدِهِ؟",
      "file": "b4fa2bcc1435.mp3",
      "seconds": 2.21,
      "stamp": "12b780c5b878"
    },
    {
      "id": "000742c0c635",
      "text": "مَا الَّذِي رَدَّدَهُ عَادِلٌ مَعَ قَائِدِ الطَّائِرَةِ؟",
      "file": "000742c0c635.mp3",
      "seconds": 2.9,
      "stamp": "970a19708dd1"
    },
    {
      "id": "ae65d6ec2ded",
      "text": "رَبَطَ عَادِلٌ حِزَامَ الْأَمَانِ اسْتِعْدَادًا لِإِقْلَاعِ الطَّائِرَةِ.",
      "file": "ae65d6ec2ded.mp3",
      "seconds": 3.79,
      "stamp": "64732d206f5f"
    },
    {
      "id": "8d5315e3e152",
      "text": "مَا الَّذِي أَدْهَشَ عَادِلًا فِي الطَّائِرَةِ؟",
      "file": "8d5315e3e152.mp3",
      "seconds": 2.23,
      "stamp": "864a7c47abb4"
    },
    {
      "id": "0f087ce56115",
      "text": "بِمَاذَا نَصَحَ الْمُعَلِّمُ أَحْمَدَ لِيَكُونَ مُتَفَوِّقًا؟",
      "file": "0f087ce56115.mp3",
      "seconds": 3.46,
      "stamp": "576d77f2e6a3"
    },
    {
      "id": "228740908f96",
      "text": "مَا الْحَلُّ لِمُشْكِلَةِ عَادِلٍ (التَّعَبِ صَبَاحًا)؟",
      "file": "228740908f96.mp3",
      "seconds": 3.41,
      "stamp": "560a458f81f6"
    },
    {
      "id": "f0c874efbe86",
      "text": "تَمَنَّى فَوَّازٌ أَنْ تَسُودَ الْمَحَبَّةُ بَيْنَ زُمَلَائِهِ.",
      "file": "f0c874efbe86.mp3",
      "seconds": 3.1,
      "stamp": "bfa153021ba7"
    },
    {
      "id": "992f9e97cb25",
      "text": "مَنْ مُوَحِّدُ الْمَمْلَكَةِ الْعَرَبِيَّةِ السُّعُودِيَّةِ؟",
      "file": "992f9e97cb25.mp3",
      "seconds": 2.83,
      "stamp": "26e7d76bc1d8"
    },
    {
      "id": "c1b059c45b55",
      "text": "لِمَاذَا سُمِّيَتِ الرِّيَاضُ بِهَذَا الِاسْمِ؟",
      "file": "c1b059c45b55.mp3",
      "seconds": 2.45,
      "stamp": "a0cdc4386134"
    },
    {
      "id": "4fe3aff2ccea",
      "text": "مِنْ مَعَالِمِ مَدِينَةِ الرِّيَاضِ:",
      "file": "4fe3aff2ccea.mp3",
      "seconds": 2.06,
      "stamp": "7037f0affbca"
    },
    {
      "id": "583171b3e27d",
      "text": "مَاذَا تُسَمَّى الطَّائِفُ؟",
      "file": "583171b3e27d.mp3",
      "seconds": 1.63,
      "stamp": "9172383c515d"
    },
    {
      "id": "ff0bb97bd129",
      "text": "فِي أَيِّ مِنْطَقَةٍ تَقَعُ غَابَةُ رَغَدَانَ؟",
      "file": "ff0bb97bd129.mp3",
      "seconds": 2.76,
      "stamp": "84afc9965621"
    },
    {
      "id": "ff964aa451c8",
      "text": "الْبَوَّابَةُ لِجُزُرِ فَرَسَانَ هِيَ مِنْطَقَةُ:",
      "file": "ff964aa451c8.mp3",
      "seconds": 2.71,
      "stamp": "9e70f45284e6"
    },
    {
      "id": "628da2448c2f",
      "text": "مَاذَا اقْتَرَحَ فَوَّازٌ لِلْمُحَافَظَةِ عَلَى بِيئَةِ الْمَدْرَسَةِ؟",
      "file": "628da2448c2f.mp3",
      "seconds": 3.62,
      "stamp": "1ffb5af04bbc"
    },
    {
      "id": "52de11907040",
      "text": "بِمَ نَجْتَازُ الصُّعُوبَاتِ كَمَا قَالَ فَوَّازٌ؟",
      "file": "52de11907040.mp3",
      "seconds": 2.88,
      "stamp": "89dfe4533c18"
    },
    {
      "id": "757906da073f",
      "text": "رَتِّبْ أَعْمَالَ الْمَجْمُوعَاتِ كَمَا وَرَدَتْ فِي النَّصِّ.",
      "file": "757906da073f.mp3",
      "seconds": 3.1,
      "stamp": "c76a0a86bd62"
    },
    {
      "id": "625d65592258",
      "text": "مَا مَعْنَى الْإِيثَارِ؟",
      "file": "625d65592258.mp3",
      "seconds": 1.32,
      "stamp": "71b5b951d317"
    },
    {
      "id": "44e7ed3a0614",
      "text": "كَمْ تَمْرَةً كَانَتْ فِي بَيْتِ أُمِّ الْمُؤْمِنِينَ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا؟",
      "file": "44e7ed3a0614.mp3",
      "seconds": 4.3,
      "stamp": "7baec725dd09"
    },
    {
      "id": "dba03ba52b7c",
      "text": "مَاذَا فَعَلَتِ الْأُمُّ بِالتَّمْرَةِ الثَّالِثَةِ؟",
      "file": "dba03ba52b7c.mp3",
      "seconds": 2.54,
      "stamp": "7f3a60f7399a"
    },
    {
      "id": "c3c9a64c5b3e",
      "text": "لِمَاذَا يُمْنَعُ الْهَاتِفُ الْمَحْمُولُ فِي الْمُسْتَشْفَى؟",
      "file": "c3c9a64c5b3e.mp3",
      "seconds": 2.88,
      "stamp": "16ebf50fe37c"
    },
    {
      "id": "a74c9a885589",
      "text": "أَهَمُّ مَكَانٍ يُغْلَقُ فِيهِ الْهَاتِفُ هُوَ:",
      "file": "a74c9a885589.mp3",
      "seconds": 2.62,
      "stamp": "d4caa5c85c9e"
    },
    {
      "id": "f69ef6728dec",
      "text": "مَا الْأَقْمَارُ الصِّنَاعِيَّةُ؟",
      "file": "f69ef6728dec.mp3",
      "seconds": 1.61,
      "stamp": "3618cf6b46f4"
    },
    {
      "id": "e2fe4fa77838",
      "text": "لِمَاذَا سُمِّيَتْ أَقْمَارًا؟",
      "file": "e2fe4fa77838.mp3",
      "seconds": 1.82,
      "stamp": "6457e7c36fe6"
    },
    {
      "id": "57b84b8c7fd5",
      "text": "بَعْضُ الْأَقْمَارِ الصِّنَاعِيَّةِ تُسَاعِدُ فِي مَعْرِفَةِ حَالَةِ الطَّقْسِ.",
      "file": "57b84b8c7fd5.mp3",
      "seconds": 4.18,
      "stamp": "dc30b58bcafc"
    },
    {
      "id": "93051afe6fae",
      "text": "مَا اسْمُ الشَّجَرَةِ الْمَذْكُورَةِ فِي الْقِصَّةِ؟",
      "file": "93051afe6fae.mp3",
      "seconds": 2.4,
      "stamp": "5f5a9792de46"
    },
    {
      "id": "dd8d1520c8a7",
      "text": "مَتَى كَانَتْ أَحْدَاثُ الْقِصَّةِ؟",
      "file": "dd8d1520c8a7.mp3",
      "seconds": 1.92,
      "stamp": "fd51b48f3b23"
    },
    {
      "id": "8f328e7dc8c2",
      "text": "اسْمُ صَوْتِ النَّحْلِ:",
      "file": "8f328e7dc8c2.mp3",
      "seconds": 1.22,
      "stamp": "dfec9aa2ba24"
    },
    {
      "id": "60cfd5d5dcf7",
      "text": "مَاذَا اتَّفَقَ عَلَيْهِ النَّحْلُ فِي النِّهَايَةِ؟",
      "file": "60cfd5d5dcf7.mp3",
      "seconds": 2.4,
      "stamp": "e44a534b6aa0"
    },
    {
      "id": "dfa3c3474bc2",
      "text": "أَيُّ كَلِمَةٍ فِيهَا (الْ) الشَّمْسِيَّةُ؟",
      "file": "dfa3c3474bc2.mp3",
      "seconds": 2.93,
      "stamp": "3d06aaef160e"
    },
    {
      "id": "27c1de75ce71",
      "text": "أَيُّ كَلِمَةٍ فِيهَا (الْ) الْقَمَرِيَّةُ؟",
      "file": "27c1de75ce71.mp3",
      "seconds": 3.02,
      "stamp": "e38578b97492"
    },
    {
      "id": "828a3825a5a4",
      "text": "اللَّامُ فِي كَلِمَةِ الشَّمْسِ تُكْتَبُ وَلَا تُنْطَقُ.",
      "file": "828a3825a5a4.mp3",
      "seconds": 2.93,
      "stamp": "7ffd9c6c7558"
    },
    {
      "id": "73b5e10e7d0a",
      "text": "نَوْعُ (الْ) فِي كَلِمَةِ (الْمَنَارَةُ):",
      "file": "73b5e10e7d0a.mp3",
      "seconds": 3.26,
      "stamp": "ad2df6ec86bf"
    },
    {
      "id": "04209211899d",
      "text": "نَوْعُ (الْ) فِي كَلِمَةِ (الرَّبِيعُ):",
      "file": "04209211899d.mp3",
      "seconds": 3.05,
      "stamp": "4a1f13417989"
    },
    {
      "id": "f99edea91ad9",
      "text": "اِخْتَرِ الْحَرْفَ الْمُنَاسِبَ لِإِكْمَالِ الْكَلِمَةِ.",
      "file": "f99edea91ad9.mp3",
      "seconds": 2.64,
      "stamp": "1f5853c1dec4"
    },
    {
      "id": "3abeb745fcb9",
      "text": "عِنْدَ الْوَقْفِ عَلَى التَّاءِ الْمَرْبُوطَةِ نَنْطِقُهَا:",
      "file": "3abeb745fcb9.mp3",
      "seconds": 2.88,
      "stamp": "219ce6bd34d6"
    },
    {
      "id": "7fd73767a1a9",
      "text": "كَلِمَةُ (عَادِلٌ) فِيهَا مَدٌّ بِـ:",
      "file": "7fd73767a1a9.mp3",
      "seconds": 2.64,
      "stamp": "2025fd896739"
    },
    {
      "id": "df8f5c28fcae",
      "text": "كَلِمَةُ (صُعُودٌ) فِيهَا مَدٌّ بِـ:",
      "file": "df8f5c28fcae.mp3",
      "seconds": 2.76,
      "stamp": "2650557a25e0"
    },
    {
      "id": "65e87e7a6077",
      "text": "كَلِمَةُ (كَبِيرَةٌ) فِيهَا مَدٌّ بِـ:",
      "file": "65e87e7a6077.mp3",
      "seconds": 2.57,
      "stamp": "8ee749c5001e"
    },
    {
      "id": "85effdd30af8",
      "text": "أَيُّ كَلِمَةٍ فِيهَا حَرْفٌ مُضَعَّفٌ (مُشَدَّدٌ)؟",
      "file": "85effdd30af8.mp3",
      "seconds": 3.36,
      "stamp": "9503f2e11061"
    },
    {
      "id": "f83f923c2441",
      "text": "الْهَمْزَةُ فِي كَلِمَةِ (اسْتِيقَاظٌ) هَمْزَةُ:",
      "file": "f83f923c2441.mp3",
      "seconds": 3.38,
      "stamp": "d304d5d59a86"
    },
    {
      "id": "5d757db5d1b9",
      "text": "الْهَمْزَةُ فِي كَلِمَةِ (أَحْمَدُ) هَمْزَةُ:",
      "file": "5d757db5d1b9.mp3",
      "seconds": 3.1,
      "stamp": "58ab1f010f16"
    },
    {
      "id": "6ed8c4ad37e7",
      "text": "الْهَمْزَةُ فِي كَلِمَةِ (ابْنٌ) هَمْزَةُ:",
      "file": "6ed8c4ad37e7.mp3",
      "seconds": 2.86,
      "stamp": "7a10a08f6b67"
    },
    {
      "id": "e4b243e74bf8",
      "text": "الْهَمْزَةُ فِي كَلِمَةِ (إِيمَانٌ) هَمْزَةُ:",
      "file": "e4b243e74bf8.mp3",
      "seconds": 3.17,
      "stamp": "fd1e83f19866"
    },
    {
      "id": "cbd27bff9fcd",
      "text": "نُوِّنَتْ كَلِمَةُ (سَبُّورَةٌ) بِتَنْوِينِ:",
      "file": "cbd27bff9fcd.mp3",
      "seconds": 2.93,
      "stamp": "77abbaed8f28"
    },
    {
      "id": "4f02a0aa5a9d",
      "text": "أَيُّ كَلِمَةٍ تَنْتَهِي بِأَلِفٍ لَيِّنَةٍ عَلَى صُورَةِ الْيَاءِ؟",
      "file": "4f02a0aa5a9d.mp3",
      "seconds": 3.58,
      "stamp": "aa4c3f8a2dee"
    },
    {
      "id": "e16c3f3ebdb1",
      "text": "أَيُّ كَلِمَةٍ تَنْتَهِي بِأَلِفٍ لَيِّنَةٍ قَائِمَةٍ؟",
      "file": "e16c3f3ebdb1.mp3",
      "seconds": 3.02,
      "stamp": "261b3c651c31"
    },
    {
      "id": "1223680628ac",
      "text": "أَيُّ الْكَلِمَاتِ فِيهَا هَمْزَةٌ مُتَوَسِّطَةٌ عَلَى الْأَلِفِ؟",
      "file": "1223680628ac.mp3",
      "seconds": 3.41,
      "stamp": "52d6f8bdd1a6"
    },
    {
      "id": "0ed0bb3d305f",
      "text": "اِسْتَمِعْ، ثُمَّ اخْتَرِ الْكِتَابَةَ الصَّحِيحَةَ.",
      "file": "0ed0bb3d305f.mp3",
      "seconds": 2.93,
      "stamp": "5bfbc8b67199"
    },
    {
      "id": "cc049bd6d69d",
      "text": "اسْتِيقَاظٌ",
      "file": "cc049bd6d69d.mp3",
      "seconds": 0.94,
      "stamp": "049ef5bc7215"
    },
    {
      "id": "047c8d5e9d66",
      "text": "الطَّائِرَةُ",
      "file": "047c8d5e9d66.mp3",
      "seconds": 0.84,
      "stamp": "b429e6c71294"
    },
    {
      "id": "4b169b70bb56",
      "text": "تَعْلِيمَاتٌ",
      "file": "4b169b70bb56.mp3",
      "seconds": 0.89,
      "stamp": "3bfed501187b"
    },
    {
      "id": "a1251e64e5fe",
      "text": "مَسْؤُولِيَّةٌ",
      "file": "a1251e64e5fe.mp3",
      "seconds": 1.01,
      "stamp": "dc983f22afdd"
    },
    {
      "id": "c0574b0f7a39",
      "text": "هَذَانِ",
      "file": "c0574b0f7a39.mp3",
      "seconds": 0.7,
      "stamp": "f24c5f6b151f"
    },
    {
      "id": "56cb458da023",
      "text": "الَّذِينَ",
      "file": "56cb458da023.mp3",
      "seconds": 0.86,
      "stamp": "9cee0e57bfd8"
    },
    {
      "id": "282df7aad03e",
      "text": "مَشَى",
      "file": "282df7aad03e.mp3",
      "seconds": 0.46,
      "stamp": "a6eadcdbe3f7"
    },
    {
      "id": "df4d5ef0a4c8",
      "text": "دَعَا",
      "file": "df4d5ef0a4c8.mp3",
      "seconds": 0.65,
      "stamp": "3b7bb0f92b18"
    },
    {
      "id": "22e84e03bdcb",
      "text": "وَجْهٌ",
      "file": "22e84e03bdcb.mp3",
      "seconds": 0.6,
      "stamp": "b163cfe18a54"
    },
    {
      "id": "a135f4904099",
      "text": "مُؤْمِنٌ",
      "file": "a135f4904099.mp3",
      "seconds": 0.74,
      "stamp": "090c4e45fe4b"
    },
    {
      "id": "336255ee83d6",
      "text": "سَأَلَ",
      "file": "336255ee83d6.mp3",
      "seconds": 0.65,
      "stamp": "7e096ed3a9f3"
    },
    {
      "id": "6f76fc7c4728",
      "text": "رَأْسٌ",
      "file": "6f76fc7c4728.mp3",
      "seconds": 0.77,
      "stamp": "f33858d7197b"
    },
    {
      "id": "1cb7605296a3",
      "text": "الْهَاتِفُ",
      "file": "1cb7605296a3.mp3",
      "seconds": 0.86,
      "stamp": "5bffd166fe9d"
    },
    {
      "id": "70f5f5b48cc3",
      "text": "الِاتِّصَالَاتُ",
      "file": "70f5f5b48cc3.mp3",
      "seconds": 1.15,
      "stamp": "31525547f89d"
    },
    {
      "id": "4f7f0ab767de",
      "text": "الْأَقْمَارُ",
      "file": "4f7f0ab767de.mp3",
      "seconds": 0.86,
      "stamp": "7acbcbcb1100"
    },
    {
      "id": "5d4aca09dd41",
      "text": "مَدْرَسَةٌ",
      "file": "5d4aca09dd41.mp3",
      "seconds": 0.79,
      "stamp": "6ba227826d8d"
    },
    {
      "id": "1f32dd423d17",
      "text": "تَعَاوُنٌ",
      "file": "1f32dd423d17.mp3",
      "seconds": 0.74,
      "stamp": "fbde29b3fb02"
    },
    {
      "id": "7f723751abd3",
      "text": "سَمَاءٌ",
      "file": "7f723751abd3.mp3",
      "seconds": 0.86,
      "stamp": "ac2735056e33"
    },
    {
      "id": "5f4acb27254c",
      "text": "جَهَّزَ أَفْرَادُ الْأُسْرَةِ حَقَائِبَهُمْ ... عَادِلًا.",
      "file": "5f4acb27254c.mp3",
      "seconds": 4.2,
      "stamp": "e30b6d6a3b66"
    },
    {
      "id": "290a270b242b",
      "text": "صَعِدَ الْمُسَافِرُونَ إِلَى الطَّائِرَةِ بِهُدُوءٍ إِلَّا ...",
      "file": "290a270b242b.mp3",
      "seconds": 3.22,
      "stamp": "7b0ee9a2cc0a"
    },
    {
      "id": "430911a1f63d",
      "text": "حَضَرَ التَّلَامِيذُ ... تِلْمِيذٍ.",
      "file": "430911a1f63d.mp3",
      "seconds": 2.83,
      "stamp": "7a831c9b231f"
    },
    {
      "id": "0925414d84e9",
      "text": "تَقِفُ الْحَافِلَةُ ... الْمَدْرَسَةِ. (عَلَى الْجَانِبِ الْأَيْسَرِ)",
      "file": "0925414d84e9.mp3",
      "seconds": 5.06,
      "stamp": "41270d9244df"
    },
    {
      "id": "6ed4ca2c00a5",
      "text": "أَسْتَيْقِظُ ... لِلذَّهَابِ إِلَى الْمَدْرَسَةِ.",
      "file": "6ed4ca2c00a5.mp3",
      "seconds": 3.34,
      "stamp": "18382fd5cc58"
    },
    {
      "id": "9bee16269ad6",
      "text": "كَلِمَةُ (صَبَاحًا) هِيَ:",
      "file": "9bee16269ad6.mp3",
      "seconds": 2.28,
      "stamp": "e0a5f9c73ee7"
    },
    {
      "id": "74702cbd8dab",
      "text": "اشْتَرَيْتُ كِتَابًا ... قَلَمًا.",
      "file": "74702cbd8dab.mp3",
      "seconds": 3.02,
      "stamp": "d9b8b3e47be2"
    },
    {
      "id": "17e0ea139618",
      "text": "طَافَ مَاجِدٌ حَوْلَ الْكَعْبَةِ ... سَعَى بَيْنَ الصَّفَا وَالْمَرْوَةِ.",
      "file": "17e0ea139618.mp3",
      "seconds": 4.3,
      "stamp": "a3fc75242582"
    },
    {
      "id": "6ff78c747816",
      "text": "زَارَ فَوَّازٌ مَزْرَعَةَ جَدِّهِ ... أَعْجَبَهُ مَنْظَرُ الْأَشْجَارِ.",
      "file": "6ff78c747816.mp3",
      "seconds": 4.85,
      "stamp": "53dea7ad4557"
    },
    {
      "id": "2c27c4f6c5e8",
      "text": "... حَالُكَ؟",
      "file": "2c27c4f6c5e8.mp3",
      "seconds": 0.72,
      "stamp": "e4e8ad52435a"
    },
    {
      "id": "a2125c0a39cb",
      "text": "... تَغْرُبُ الشَّمْسُ؟",
      "file": "a2125c0a39cb.mp3",
      "seconds": 1.15,
      "stamp": "9ac7ef98161b"
    },
    {
      "id": "f7e812a0f607",
      "text": "... زَارَكُمْ؟",
      "file": "f7e812a0f607.mp3",
      "seconds": 0.94,
      "stamp": "592da1f4df95"
    },
    {
      "id": "fffce0d6bc77",
      "text": "... وَلَدَانِ مُهَذَّبَانِ.",
      "file": "fffce0d6bc77.mp3",
      "seconds": 1.61,
      "stamp": "fb05b7954103"
    },
    {
      "id": "1a52e44e6615",
      "text": "... زَهْرَةٌ مُتَفَتِّحَةٌ.",
      "file": "1a52e44e6615.mp3",
      "seconds": 1.58,
      "stamp": "23e62ab6138c"
    },
    {
      "id": "6ae6c9fb802d",
      "text": "... مُعَلِّمَاتٌ.",
      "file": "6ae6c9fb802d.mp3",
      "seconds": 1.06,
      "stamp": "99ca65be876a"
    },
    {
      "id": "6b694e278ff9",
      "text": "الرِّيَاضُ ... مُدُنِ الْمَمْلَكَةِ.",
      "file": "6b694e278ff9.mp3",
      "seconds": 2.88,
      "stamp": "ab06637e098d"
    },
    {
      "id": "e54a0504fa67",
      "text": "الشَّمْسُ ... مِنَ الْقَمَرِ.",
      "file": "e54a0504fa67.mp3",
      "seconds": 2.4,
      "stamp": "1a3cca1d23f3"
    },
    {
      "id": "4075ce10fa1d",
      "text": "اسْمُ التَّفْضِيلِ يَأْتِي عَلَى وَزْنِ:",
      "file": "4075ce10fa1d.mp3",
      "seconds": 2.06,
      "stamp": "292d49417972"
    },
    {
      "id": "2e4f97bc6fe5",
      "text": "الْفِعْلُ (يَكْتُبُ) فِعْلٌ:",
      "file": "2e4f97bc6fe5.mp3",
      "seconds": 2.4,
      "stamp": "4a27a0284d05"
    },
    {
      "id": "27b74a5a53a5",
      "text": "الْفِعْلُ (اُكْتُبْ) فِعْلُ:",
      "file": "27b74a5a53a5.mp3",
      "seconds": 2.26,
      "stamp": "3c35ef13348a"
    },
    {
      "id": "8e667f2a8e2f",
      "text": "الْفِعْلُ (زَارَ) فِعْلٌ:",
      "file": "8e667f2a8e2f.mp3",
      "seconds": 2.23,
      "stamp": "794499b000d8"
    },
    {
      "id": "374fa9fc02dc",
      "text": "مَا ... الْحَدِيقَةَ!",
      "file": "374fa9fc02dc.mp3",
      "seconds": 2.09,
      "stamp": "87b67f75c4c7"
    },
    {
      "id": "3865071f12fa",
      "text": "أَيُّ جُمْلَةٍ فِيهَا أُسْلُوبُ تَعَجُّبٍ؟",
      "file": "3865071f12fa.mp3",
      "seconds": 2.5,
      "stamp": "bd50ecd52f68"
    },
    {
      "id": "5806531e663f",
      "text": "(الْقَمَرُ الصِّنَاعِيُّ أَسْرَعُ مِنَ الطَّائِرَةِ) أُسْلُوبُ:",
      "file": "5806531e663f.mp3",
      "seconds": 3.31,
      "stamp": "76144040d32a"
    },
    {
      "id": "d7f5cb7c0c65",
      "text": "كَلِمَةُ (مِنْ) هِيَ:",
      "file": "d7f5cb7c0c65.mp3",
      "seconds": 1.73,
      "stamp": "d61617b1e96d"
    },
    {
      "id": "89b4aabb4fac",
      "text": "كَلِمَةُ (قِصَّةٌ) هِيَ:",
      "file": "89b4aabb4fac.mp3",
      "seconds": 1.68,
      "stamp": "4146d2b78df6"
    },
    {
      "id": "686293663605",
      "text": "مُثَنَّى كَلِمَةِ (طَالِبَةٌ):",
      "file": "686293663605.mp3",
      "seconds": 1.9,
      "stamp": "a72da3d289eb"
    },
    {
      "id": "45dcba55404c",
      "text": "جَمْعُ كَلِمَةِ (كِتَابٌ):",
      "file": "45dcba55404c.mp3",
      "seconds": 2.04,
      "stamp": "8102216c0886"
    },
    {
      "id": "6bb9a4173523",
