    {
      "id": "efc4efd4c04f",
      "text": "إِنَّ مِنْ خِيَارِكُمْ أَحْسَنَكُمْ أَخْلَاقًا.",
      "file": "efc4efd4c04f.mp3",
      "seconds": 2.57,
      "stamp": "cbff19c628c8"
    },
    {
      "id": "62f1848a77f8",
      "text": "أَكْمَلُ الْمُؤْمِنِينَ إِيمَانًا أَحْسَنُهُمْ خُلُقًا.",
      "file": "62f1848a77f8.mp3",
      "seconds": 2.93,
      "stamp": "bbbdd760e0b2"
    },
    {
      "id": "de69e6182a05",
      "text": "الطَّائِرَةُ لَيْسَتْ مَكَانًا لِلَّعِبِ يَا أَبِي!",
      "file": "de69e6182a05.mp3",
      "seconds": 2.76,
      "stamp": "3403cd64bf3a"
    },
    {
      "id": "4b496a3d4cd7",
      "text": "أَعْتَذِرُ عَنْ خَطَئِي يَا عَمُّ، وَأَرْجُو أَنْ تُسَامِحَنِي.",
      "file": "4b496a3d4cd7.mp3",
      "seconds": 3.74,
      "stamp": "05f943d260cf"
    },
    {
      "id": "81bff09548c3",
      "text": "الرِّيَاضُ عَاصِمَةُ مَمْلَكَتِنَا الْغَالِيَةِ وَأَكْبَرُ مُدُنِهَا.",
      "file": "81bff09548c3.mp3",
      "seconds": 3.7,
      "stamp": "b4bce1328f23"
    },
    {
      "id": "7043684c8b0f",
      "text": "وَطَنِي شَجَرَةٌ وَارِفَةُ الظِّلَالِ، نَسْقِيهَا بِالْحُبِّ وَالْعَمَلِ.",
      "file": "7043684c8b0f.mp3",
      "seconds": 4.32,
      "stamp": "77f46d3c06fb"
    },
    {
      "id": "7ffdeb133a1d",
      "text": "بِالتَّعَاوُنِ نَجْتَازُ الصُّعُوبَاتِ، وَنُحَقِّقُ الْغَايَاتِ.",
      "file": "7ffdeb133a1d.mp3",
      "seconds": 4.01,
      "stamp": "b5dbb1eee92d"
    },
    {
      "id": "27683bbaa59b",
      "text": "الْإِيثَارُ أَنْ تُقَدِّمَ غَيْرَكَ عَلَى نَفْسِكَ.",
      "file": "27683bbaa59b.mp3",
      "seconds": 2.86,
      "stamp": "2cc0987ed9ca"
    },
    {
      "id": "c4604914f22b",
      "text": "الْهَاتِفُ الْمَحْمُولُ نِعْمَةٌ مِنَ اللَّهِ، فَلْنُحْسِنِ اسْتِخْدَامَهُ.",
      "file": "c4604914f22b.mp3",
      "seconds": 3.96,
      "stamp": "d79858aa2810"
    },
    {
      "id": "aeade3ef8270",
      "text": "الْأَقْمَارُ الصِّنَاعِيَّةُ أَجْسَامٌ تَدُورُ حَوْلَ الْأَرْضِ.",
      "file": "aeade3ef8270.mp3",
      "seconds": 3.29,
      "stamp": "aa6f7cb89c91"
    },
    {
      "id": "ef4a1803477e",
      "text": "دَخَلَ الْوَالِدُ حَامِلًا تَذَاكِرَ السَّفَرِ، فَاسْتَقْبَلَتْهُ الْأُسْرَةُ بِفَرَحٍ. وَصَلَتِ الْأُسْرَةُ إِلَى الْمَطَارِ، وَجَلَسَ أَفْرَادُهَا فِي صَالَةِ الِانْتِظَارِ، غَيْرَ امْرَأَةٍ تَحْمِلُ طِفْلًا لَمْ تَجِدْ مَكَانًا تَجْلِسُ فِيهِ. رَآهَا عَادِلٌ فَقَامَ عَنْ مَقْعَدِهِ وَأَجْلَسَهَا. صَعِدَ عَادِلٌ إِلَى الطَّائِرَةِ بِهُدُوءٍ، فَأَرْشَدَهُ الْمُضِيفُ إِلَى مَقْعَدِهِ، فَجَلَسَ وَرَبَطَ حِزَامَ الْأَمَانِ، وَاسْتَمَعَ إِلَى تَعْلِيمَاتِ السَّلَامَةِ، وَرَدَّدَ دُعَاءَ السَّفَرِ. ثُمَّ سَمِعَ ضَجِيجًا، فَإِذَا أَطْفَالٌ يَرْكُضُونَ فِي مَمَرَّاتِ الطَّائِرَةِ، فَقَالَ: الطَّائِرَةُ لَيْسَتْ مَكَانًا لِلَّعِبِ يَا أَبِي! فَقَالَ الْأَبُ: أَحْسَنْتَ يَا عَادِلُ.",
      "file": "ef4a1803477e.mp3",
      "seconds": 42.86,
      "stamp": "46d54b3cd0e9"
    },
    {
      "id": "0375aea7da40",
      "text": "فِي أَوَّلِ يَوْمٍ مِنَ الْعَامِ الدِّرَاسِيِّ، سَأَلَ الْمُعَلِّمُ تَلَامِيذَهُ: مَاذَا يَتَمَنَّى كُلُّ وَاحِدٍ مِنْكُمْ؟ قَالَ أَحْمَدُ: أَتَمَنَّى أَنْ أَكُونَ مِنَ الْمُتَفَوِّقِينَ. فَقَالَ الْمُعَلِّمُ: اقْرَأِ الدَّرْسَ فِي الْيَوْمِ السَّابِقِ، وَتَابِعِ الشَّرْحَ، وَرَاجِعْ دُرُوسَكَ دَائِمًا. قَالَ عَادِلٌ ضَاحِكًا: كُنْتُ أَتَمَنَّى أَنْ أَنَامَ؛ فَأَنَا مُتْعَبٌ. فَقَالَ الْمُعَلِّمُ: نَمْ مُبَكِّرًا لِتَسْتَيْقِظَ لِصَلَاةِ الْفَجْرِ. وَقَالَ فَوَّازٌ: أَتَمَنَّى أَنْ تَسُودَ الْمَحَبَّةُ بَيْنَنَا. فَقَالَ الْمُعَلِّمُ: أَحْسَنْتَ يَا فَوَّازُ، عَلَيْنَا أَنْ نَتَجَنَّبَ الْمُشَاحَنَاتِ وَالْخِصَامَ.",
      "file": "0375aea7da40.mp3",
      "seconds": 41.04,
      "stamp": "710a1772d0d2"
    },
    {
      "id": "e4015109a47d",
      "text": "زَارَتْ نُورَةُ مَعَ أُسْرَتِهَا مَدِينَةَ الرِّيَاضِ. قَالَتِ الْأُمُّ: مُوَحِّدُ مَمْلَكَتِنَا هُوَ الْمَلِكُ عَبْدُ الْعَزِيزِ آلُ سُعُودٍ، الْقَائِدُ الشُّجَاعُ الَّذِي اسْتَرَدَّ الرِّيَاضَ وَوَحَّدَ الْبِلَادَ تَحْتَ رَايَةِ التَّوْحِيدِ. سَأَلَتْ نُورَةُ: لِمَاذَا سُمِّيَتِ الرِّيَاضُ بِهَذَا الِاسْمِ؟ قَالَ الْأَبُ: لِأَنَّهَا كَانَتْ رِيَاضًا خَضْرَاءَ، كَثِيرَةَ الْبَسَاتِينِ. وَالرِّيَاضُ عَاصِمَةُ الْمَمْلَكَةِ وَأَكْبَرُ مُدُنِهَا، فِيهَا الْوِزَارَاتُ وَالسَّفَارَاتُ، وَمِنْ مَعَالِمِهَا قَصْرُ الْمَصْمَكِ وَالدِّرْعِيَّةُ وَالْمَتْحَفُ الْوَطَنِيُّ.",
      "file": "e4015109a47d.mp3",
      "seconds": 33.86,
      "stamp": "2d727a2bad02"
    },
    {
      "id": "d22a289c4102",
      "text": "تَحَدَّثَ مُهَنَّدٌ عَنِ الطَّائِفِ، وَتُسَمَّى عَرُوسَ الْمَصَايِفِ، وَمِنْ مُتَنَزَّهَاتِهَا الشَّفَا وَالْهَدَا، وَتَشْتَهِرُ بِزِرَاعَةِ الْعِنَبِ وَالرُّمَّانِ. وَتَحَدَّثَ عَنِ الْبَاحَةِ وَغَابَاتِهَا، وَمِنْ أَشْهَرِهَا غَابَةُ رَغَدَانَ. ثُمَّ تَحَدَّثَ حَامِدٌ عَنْ أَبْهَا، وَتُسَمَّى عَرُوسَ الْجَبَلِ، وَفِيهَا مُتَنَزَّهُ عَسِيرٍ الْوَطَنِيُّ. وَمِنْ مَصَايِفِنَا الْجَمِيلَةِ مِنْطَقَةُ جَازَانَ، وَهِيَ الْبَوَّابَةُ لِجُزُرِ فَرَسَانَ، وَمَدِينَةُ نَجْرَانَ الَّتِي فِيهَا آثَارُ الْأُخْدُودِ.",
      "file": "d22a289c4102.mp3",
      "seconds": 32.45,
      "stamp": "e0bf17c4d722"
    },
    {
      "id": "f6807b719638",
      "text": "فِي يَوْمِ الْبِيئَةِ الْعَالَمِيِّ، طَلَبَ الْمُعَلِّمُ مِنْ تَلَامِيذِهِ اقْتِرَاحَاتٍ لِلْمُحَافَظَةِ عَلَى بِيئَةِ الْمَدْرَسَةِ. قَالَ فَوَّازٌ: فِي الْمَدْرَسَةِ سَاحَةٌ وَاسِعَةٌ، لِمَ لَا نَزْرَعُهَا لِتُصْبِحَ حَدِيقَةً؟ قَالَ حَازِمٌ: السَّاحَةُ وَاسِعَةٌ وَنَحْنُ صِغَارٌ! قَالَ فَوَّازٌ: بِالتَّعَاوُنِ نَجْتَازُ الصُّعُوبَاتِ. فَقَسَّمَ الْمُعَلِّمُ التَّلَامِيذَ مَجْمُوعَاتٍ: مَجْمُوعَةٌ تُنَظِّفُ السَّاحَةَ، وَثَانِيَةٌ تَحْفِرُ، وَثَالِثَةٌ تَغْرِسُ الشَّتَلَاتِ، وَرَابِعَةٌ تَسْقِيهَا. وَمَا انْتَهَى الْيَوْمُ حَتَّى صَارَتِ السَّاحَةُ حَدِيقَةً خَضْرَاءَ.",
      "file": "f6807b719638.mp3",
      "seconds": 37.54,
      "stamp": "ab6529c6f43d"
    },
    {
      "id": "28d74e466d76",
      "text": "اشْتَرَى فَوَّازٌ قِصَّةً عُنْوَانُهَا الْإِيثَارُ. وَفِي الْقِصَّةِ أَنَّ امْرَأَةً فَقِيرَةً وَمَعَهَا ابْنَتَاهَا طَرَقَتْ بَابَ أُمِّ الْمُؤْمِنِينَ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا، فَلَمْ تَجِدْ فِي بَيْتِهَا إِلَّا ثَلَاثَ تَمَرَاتٍ فَأَعْطَتْهَا إِيَّاهَا. فَأَعْطَتِ الْأُمُّ كُلَّ ابْنَةٍ تَمْرَةً، وَرَفَعَتِ الثَّالِثَةَ لِتَأْكُلَهَا، فَطَلَبَتْهَا الْبِنْتَانِ، فَقَسَمَتْهَا بَيْنَهُمَا. قَالَ فَوَّازٌ: الْإِيثَارُ أَنْ تُقَدِّمَ غَيْرَكَ عَلَى نَفْسِكَ.",
      "file": "28d74e466d76.mp3",
      "seconds": 27.96,
      "stamp": "460ac337e8bb"
    },
    {
      "id": "1a589d81507b",
      "text": "زَارَ فَوَّازٌ وَوَالِدُهُ جَارَهُمْ فِي الْمُسْتَشْفَى، فَرَأَى فَوَّازٌ لَوْحَةً مَكْتُوبًا عَلَيْهَا: يُمْنَعُ اسْتِخْدَامُ الْهَاتِفِ الْمَحْمُولِ. قَالَ الْوَالِدُ: الْهَاتِفُ قَدْ يُؤَثِّرُ عَلَى بَعْضِ الْأَجْهِزَةِ الطِّبِّيَّةِ. وَهُنَاكَ أَمَاكِنُ أُخْرَى، مِثْلُ الطَّائِرَاتِ، وَأَهَمُّهَا الْمَسَاجِدُ؛ فَرَنِينُ الْهَاتِفِ يُزْعِجُ الْمُصَلِّينَ. إِنَّ الْهَاتِفَ الْمَحْمُولَ نِعْمَةٌ مِنَ اللَّهِ، وَبَعْضُنَا يُسِيءُ اسْتِخْدَامَهُ.",
      "file": "1a589d81507b.mp3",
      "seconds": 27.6,
      "stamp": "7d58f3e2ac7d"
    },
    {
      "id": "db9141acc005",
      "text": "سَأَلَتْ دَانِيَةُ وَالِدَهَا: كَيْفَ تُنْقَلُ صُوَرُ التِّلْفَازِ مِنْ مَكَانٍ إِلَى آخَرَ؟ قَالَ: عَنْ طَرِيقِ الْأَقْمَارِ الصِّنَاعِيَّةِ، وَهِيَ أَجْسَامٌ تَدُورُ فِي الْفَضَاءِ حَوْلَ الْأَرْضِ، صَنَعَهَا الْإِنْسَانُ. بَعْضُهَا لِمَعْرِفَةِ حَالَةِ الطَّقْسِ، وَبَعْضُهَا لِلِاتِّصَالَاتِ، وَبَعْضُهَا لِنَقْلِ الْبَثِّ التِّلْفَازِيِّ. وَسُمِّيَتْ أَقْمَارًا لِأَنَّهَا تُشْبِهُ الْقَمَرَ فِي دَوَرَانِهِ حَوْلَ الْأَرْضِ.",
      "file": "db9141acc005.mp3",
