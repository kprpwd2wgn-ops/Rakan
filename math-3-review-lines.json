  {
   "id": "ebe061f6f0ae",
   "text": "مَا مَنْزِلَةُ الرَّقْمِ 4 فِي الْعَدَدِ 46309؟"
  },
  {
   "id": "9693f513e11e",
   "text": "اُكْتُبِ الْعَدَدَ بِالصِّيغَةِ الْقِيَاسِيَّةِ: 4000 زَائِدَ 300 زَائِدَ 20 زَائِدَ 5."
  },
  {
   "id": "e1948580d566",
   "text": "اُكْتُبِ الْعَدَدَ بِالصِّيغَةِ الْقِيَاسِيَّةِ: 6000 زَائِدَ 50 زَائِدَ 8."
  },
  {
   "id": "93f95960af69",
   "text": "مَا الصِّيغَةُ التَّحْلِيلِيَّةُ لِلْعَدَدِ 2734؟"
  },
  {
   "id": "393da48091d2",
   "text": "اُكْتُبْ بِالْأَرْقَامِ: ثَلَاثَةُ آلَافٍ وَخَمْسُمِئَةٍ وَأَرْبَعُونَ."
  },
  {
   "id": "6addc4469fc6",
   "text": "أَيُّ الْعَدَدَيْنِ أَكْبَرُ: 3456 أَمْ 3465؟"
  },
  {
   "id": "be1afcff2d23",
   "text": "أَيُّ الْعَدَدَيْنِ أَصْغَرُ: 8709 أَمْ 8790؟"
  },
  {
   "id": "d50fc1adc33f",
   "text": "أَيُّ الْأَعْدَادِ الْآتِيَةِ هُوَ الْأَكْبَرُ؟"
  },
  {
   "id": "d439ccc745fe",
   "text": "رَتِّبِ الْأَعْدَادَ مِنَ الْأَصْغَرِ إِلَى الْأَكْبَرِ."
  },
  {
   "id": "2ba9989fee69",
   "text": "رَتِّبِ الْأَعْدَادَ مِنَ الْأَكْبَرِ إِلَى الْأَصْغَرِ."
  },
  {
   "id": "f3db9672b914",
   "text": "قَرِّبِ الْعَدَدَ 67 إِلَى أَقْرَبِ عَشَرَةٍ."
  },
  {
   "id": "5a7b52ca1767",
