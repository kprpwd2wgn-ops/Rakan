   "text": "الصِّحَّةُ وَالْجِسْمُ."
  },
  {
   "id": "t-study",
   "text": "الدِّرَاسَةُ وَالْمَوَادُّ."
  },
  {
   "id": "t-around",
   "text": "فِي الْمَدِينَةِ."
  },
  {
   "id": "t-trips",
   "text": "السَّفَرُ وَالرِّحْلَاتُ."
  },
  {
   "id": "t-landscape",
   "text": "الْأَرْضُ وَالطَّبِيعَةُ."
  },
  {
   "id": "t-creatures",
   "text": "حَيَوَانَاتٌ وَطُيُورٌ."
  },
  {
   "id": "t-hobbies",
   "text": "الْهِوَايَاتُ وَالرِّيَاضَةُ."
  },
  {
   "id": "t-actions",
   "text": "أَفْعَالٌ مُفِيدَةٌ."
  },
  {
   "id": "t-describing",
   "text": "صِفَاتٌ جَدِيدَةٌ."
  },
  {
   "id": "t-timewords",
   "text": "الْوَقْتُ وَالتَّكْرَارُ."
  },
  {
   "id": "t-people2",
   "text": "النَّاسُ مِنْ حَوْلِنَا."
  },
  {
   "id": "t-class2",
   "text": "جُمَلُ الْحِصَّةِ."
  },
  {
   "id": "part-hello",
   "text": "أَهْلًا بِكَ فِي الْجُزْءِ الثَّانِي مِنْ صَقْرِ الْكَلِمَاتِ! كَلِمَاتٌ أَصْعَبُ، وَتَحَدٍّ أَكْبَرُ."
  },
  {
   "id": "part-plan",
   "text": "فِي كُلِّ يَوْمٍ: دَرْسٌ جَدِيدٌ، وَإِمْلَاءٌ، وَقَاعِدَةٌ، وَتَحَدُّثٌ، وَمُرَاجَعَةٌ."
  },
  {
   "id": "r2-past-1",
   "text": "عِنْدَمَا نَتَحَدَّثُ عَنِ الْمَاضِي، نُضِيفُ إِلَى أَكْثَرِ الْأَفْعَالِ حُرُوفًا فِي آخِرِهَا:"
  },
  {
   "id": "r2-past-2",
   "text": "وَبَعْضُ الْأَفْعَالِ تَتَغَيَّرُ كُلُّهَا، فَنَحْفَظُهَا:"
  },
  {
   "id": "r2-many-1",
   "text": "مَعَ الْأَشْيَاءِ الَّتِي نَعُدُّهَا، مِثْلَ التُّفَّاحِ، نَقُولُ:"
  },
  {
   "id": "r2-many-2",
   "text": "وَمَعَ الْأَشْيَاءِ الَّتِي لَا نَعُدُّهَا، مِثْلَ الْمَاءِ، نَقُولُ:"
  },
  {
   "id": "r2-going-1",
   "text": "لِلْحَدِيثِ عَنْ خُطَطِ الْمُسْتَقْبَلِ نَقُولُ:"
  },
  {
   "id": "r2-going-2",
   "text": "وَمَعَ هُوَ وَهِيَ نَقُولُ:"
  },
  {
   "id": "r2-freq-1",
   "text": "كَلِمَاتُ التَّكْرَارِ، مِثْلَ: دَائِمًا وَأَحْيَانًا وَأَبَدًا، تَأْتِي قَبْلَ الْفِعْلِ:"
  },
  {
   "id": "r2-than-1",
   "text": "لِلْمُقَارَنَةِ مَعَ الصِّفَاتِ الْقَصِيرَةِ، نُضِيفُ حُرُوفًا فِي آخِرِهَا:"
  },
  {
   "id": "r2-than-2",
   "text": "وَمَعَ الصِّفَاتِ الطَّوِيلَةِ، نَضَعُ قَبْلَهَا كَلِمَةً:"
  },
  {
   "id": "r2-must-1",
   "text": "لِلشَّيْءِ الْوَاجِبِ نَقُولُ:"
  },
  {
   "id": "r2-must-2",
   "text": "وَلِلشَّيْءِ الْمَمْنُوعِ نَقُولُ:"
  },
  {
   "id": "r2-must-3",
   "text": "وَبَعْدَهُمَا يَأْتِي الْفِعْلُ كَمَا هُوَ، بِلَا زِيَادَةٍ."
  }
 ]
