{
 "voice": "ar-SA-HamedNeural",
 "lines": [
  {
   "id": "t-chores",
   "text": "أَعْمَالُ الْبَيْتِ."
  },
  {
   "id": "t-nutrition",
   "text": "الطَّعَامُ وَالتَّغْذِيَةُ."
  },
  {
   "id": "t-money",
   "text": "الْمَالُ وَالْعَمَلُ."
  },
  {
   "id": "t-media",
   "text": "الْأَخْبَارُ وَالتَّوَاصُلُ."
  },
  {
   "id": "t-road",
   "text": "الطَّرِيقُ وَالْمُوَاصَلَاتُ."
  },
  {
   "id": "t-sciences",
   "text": "الْعُلُومُ وَالتَّجَارِبُ."
  },
  {
   "id": "t-universe",
   "text": "الْفَضَاءُ وَالْكَوْنُ."
  },
  {
   "id": "t-environment",
   "text": "الْبِيئَةُ وَالطَّاقَةُ."
  },
  {
   "id": "t-peoples",
   "text": "الْعَالَمُ وَالشُّعُوبُ."
  },
  {
   "id": "t-weather3",
   "text": "الطَّقْسُ وَقُوَّةُ الطَّبِيعَةِ."
  },
  {
   "id": "t-emotions",
   "text": "مَشَاعِرُ أَكْثَرَ."
  },
  {
   "id": "t-character",
   "text": "الشَّخْصِيَّةُ."
  },
  {
   "id": "t-thinking",
   "text": "التَّفْكِيرُ وَالرَّأْيُ."
  },
  {
   "id": "t-linking",
   "text": "كَلِمَاتُ الرَّبْطِ."
  },
  {
   "id": "t-class3",
   "text": "جُمَلُ الْحِصَّةِ."
  },
  {
   "id": "part-hello",
   "text": "أَهْلًا بِكَ فِي الْجُزْءِ الثَّالِثِ مِنْ صَقْرِ الْكَلِمَاتِ! صِرْتَ فِي الْمُسْتَوَى الْمُتَوَسِّطِ."
  },
  {
   "id": "part-plan",
   "text": "فِي كُلِّ يَوْمٍ: دَرْسٌ جَدِيدٌ، وَإِمْلَاءٌ، وَقَاعِدَةٌ، وَتَحَدُّثٌ، وَمُرَاجَعَةٌ."
  },
  {
   "id": "r3-perf-1",
   "text": "لِلْحَدِيثِ عَنْ شَيْءٍ حَدَثَ، وَلَا نَذْكُرُ مَتَى حَدَثَ، نَقُولُ:"
  },
  {
   "id": "r3-perf-2",
   "text": "وَمَعَ هُوَ وَهِيَ نَقُولُ:"
  },
  {
   "id": "r3-perf-3",
   "text": "وَلِلسُّؤَالِ عَنِ التَّجْرِبَةِ نَقُولُ:"
  },
  {
   "id": "r3-pc-1",
   "text": "لِشَيْءٍ كَانَ يَحْدُثُ فِي وَقْتٍ مُعَيَّنٍ مِنَ الْمَاضِي، نَقُولُ:"
  },
  {
   "id": "r3-pc-2",
   "text": "وَمَعَ أَنْتَ وَنَحْنُ وَهُمْ نَقُولُ:"
  },
  {
   "id": "r3-pc-3",
   "text": "وَنَقُولُهُ مَعَ شَيْءٍ قَصِيرٍ حَدَثَ فِي أَثْنَائِهِ:"
  },
  {
   "id": "r3-if-1",
   "text": "لِلشَّرْطِ فِي الْمُسْتَقْبَلِ نَقُولُ:"
  },
  {
   "id": "r3-if-2",
   "text": "وَبَعْدَ أَدَاةِ الشَّرْطِ لَا نَقُولُ كَلِمَةَ الْمُسْتَقْبَلِ."
  },
  {
   "id": "r3-should-1",
   "text": "لِلنَّصِيحَةِ نَقُولُ:"
  },
  {
   "id": "r3-should-2",
   "text": "وَلِلنَّصِيحَةِ بِأَلَّا نَفْعَلَ شَيْئًا نَقُولُ:"
  },
  {
   "id": "r3-who-1",
   "text": "لِلنَّاسِ نَقُولُ:"
  },
  {
   "id": "r3-who-2",
   "text": "وَلِلْأَشْيَاءِ وَالْحَيَوَانَاتِ نَقُولُ:"
  },
  {
   "id": "r3-who-3",
   "text": "وَلِلْأَمَاكِنِ نَقُولُ:"
  },
  {
   "id": "r3-used-1",
   "text": "لِعَادَةٍ كَانَتْ فِي الْمَاضِي ثُمَّ انْتَهَتْ، نَقُولُ:"
  },
  {
   "id": "r3-used-2",
   "text": "وَفِي السُّؤَالِ وَالنَّفْيِ نَحْذِفُ الْحَرْفَ الْأَخِيرَ:"
  }
 ]
}
