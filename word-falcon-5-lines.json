{
 "voice": "ar-SA-HamedNeural",
 "lines": [
  {
   "id": "t-faith",
   "text": "الْإِيمَانُ وَالْأَخْلَاقُ."
  },
  {
   "id": "t-society",
   "text": "الْمُجْتَمَعُ وَالْقَانُونُ."
  },
  {
   "id": "t-health5",
   "text": "الصِّحَّةُ وَالطِّبُّ."
  },
  {
   "id": "t-economy",
   "text": "الْعَمَلُ وَالِاقْتِصَادُ."
  },
  {
   "id": "t-tourism",
   "text": "السِّيَاحَةُ وَالسَّفَرُ."
  },
  {
   "id": "t-research",
   "text": "الْبَحْثُ وَالدِّرَاسَةُ."
  },
  {
   "id": "t-earth5",
   "text": "الْأَرْضُ وَالْمُنَاخُ."
  },
  {
   "id": "t-animals5",
   "text": "عَالَمُ الْحَيَوَانِ."
  },
  {
   "id": "t-media5",
   "text": "الْإِعْلَامُ وَالْإِعْلَانَاتُ."
  },
  {
   "id": "t-materials",
   "text": "الْمَوَادُّ وَخَصَائِصُهَا."
  },
  {
   "id": "t-ideas5",
   "text": "كَلِمَاتُ الْأَفْكَارِ."
  },
  {
   "id": "t-thinkverbs",
   "text": "أَفْعَالُ التَّفْكِيرِ وَالنِّقَاشِ."
  },
  {
   "id": "t-people5",
   "text": "صِفَاتُ النَّاسِ."
  },
  {
   "id": "t-discourse5",
   "text": "كَلِمَاتٌ لِلرَّبْطِ وَالتَّرْتِيبِ."
  },
  {
   "id": "t-class5",
   "text": "جُمَلُ الْحِصَّةِ."
  },
  {
   "id": "part-hello",
   "text": "أَهْلًا بِكَ فِي الْجُزْءِ الْخَامِسِ مِنْ صَقْرِ الْكَلِمَاتِ! هَذِهِ كَلِمَاتُ الْمُسْتَوَى الْمُتَقَدِّمِ."
  },
  {
   "id": "part-plan",
   "text": "فِي كُلِّ يَوْمٍ: دَرْسٌ جَدِيدٌ، وَإِمْلَاءٌ، وَقَاعِدَةٌ، وَتَحَدُّثٌ، وَمُرَاجَعَةٌ."
  },
  {
   "id": "r5-pp-1",
   "text": "لِشَيْءٍ حَدَثَ قَبْلَ شَيْءٍ آخَرَ فِي الْمَاضِي، نَقُولُ:"
  },
  {
   "id": "r5-pp-2",
   "text": "وَفِي النَّفْيِ نَقُولُ:"
  },
  {
   "id": "r5-pp-3",
   "text": "وَلِلسُّؤَالِ نَقُولُ:"
  },
  {
   "id": "r5-if3-1",
   "text": "لِشَيْءٍ لَمْ يَحْدُثْ فِي الْمَاضِي، وَنَتَخَيَّلُ لَوْ أَنَّهُ حَدَثَ، نَقُولُ:"
  },
  {
   "id": "r5-if3-2",
   "text": "وَفِي الْجَوَابِ نَقُولُ هَذِهِ الْكَلِمَاتِ الثَّلَاثَ:"
  },
  {
   "id": "r5-wish-1",
   "text": "لِنَتَمَنَّى شَيْئًا لَيْسَ عِنْدَنَا الْآنَ، نَقُولُ الْفِعْلَ فِي الْمَاضِي:"
  },
  {
   "id": "r5-wish-2",
   "text": "وَلِنَتَمَنَّى قُدْرَةً لَيْسَتْ عِنْدَنَا، نَقُولُ:"
  },
  {
   "id": "r5-wish-3",
   "text": "وَلِنَنْدَمَ عَلَى شَيْءٍ فِي الْمَاضِي، نَقُولُ:"
  },
  {
   "id": "r5-must-1",
   "text": "عِنْدَمَا نَكُونُ مُتَأَكِّدِينَ تَقْرِيبًا، نَقُولُ:"
  },
  {
   "id": "r5-must-2",
   "text": "وَعِنْدَمَا نَظُنُّ أَنَّهُ مُمْكِنٌ فَقَطْ، نَقُولُ:"
  },
  {
   "id": "r5-must-3",
   "text": "وَعِنْدَمَا نَكُونُ مُتَأَكِّدِينَ أَنَّهُ غَيْرُ صَحِيحٍ، نَقُولُ:"
  },
  {
   "id": "r5-whose-1",
   "text": "لِنَتَكَلَّمَ عَمَّا يَمْلِكُهُ شَخْصٌ، نَقُولُ:"
  },
  {
   "id": "r5-whose-2",
   "text": "وَلِنُضِيفَ مَعْلُومَةً بَيْنَ فَاصِلَتَيْنِ، نَقُولُ:"
  },
  {
   "id": "r5-so-1",
   "text": "قَبْلَ الصِّفَةِ وَحْدَهَا، نَقُولُ:"
  },
  {
   "id": "r5-so-2",
   "text": "وَقَبْلَ الصِّفَةِ مَعَ اسْمٍ بَعْدَهَا، نَقُولُ:"
  },
  {
   "id": "r5-so-3",
   "text": "وَلِنَذْكُرَ النَّتِيجَةَ، نَزِيدُ هَذِهِ الْكَلِمَةَ:"
  }
 ]
}
